# ---- Stage 1: Build dell'applicazione Vue.js con Node ----
FROM node:lts AS builder

# Imposta la cartella di lavoro
WORKDIR /app

# Imposta HOME su /tmp per evitare problemi di permessi con la cache di Yarn
ENV HOME=/tmp

# Copia i file di configurazione e le dipendenze
COPY webui/package.json webui/yarn.lock webui/.yarnrc.yml ./
COPY webui/.yarn ./.yarn

# Installa le dipendenze con Yarn (modalità immutabile, senza modificare il lockfile)
RUN yarn install --immutable

# Copia il resto del codice sorgente del frontend
COPY webui/ .

# Compila l'applicazione per la produzione
RUN yarn run build-prod

# ---- Stage 2: Web server Nginx per servire i file statici ----
FROM nginx:stable

# Copia i file compilati dallo stage di build nella directory pubblica di Nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# Espone la porta 80 (standard HTTP per i web server)
EXPOSE 80
