# Imposta Node.js come immagine base
FROM node:lts

# Imposta la working directory
WORKDIR /app

# Imposta HOME su /tmp per evitare problemi di permessi con utenti non-root
ENV HOME=/tmp

# Copia i file di configurazione e le dipendenze
COPY webui/package.json webui/yarn.lock webui/.yarnrc.yml ./
COPY webui/.yarn ./.yarn

# Installa le dipendenze con Yarn (modalità immutabile, senza modificare il lockfile)
RUN yarn install --immutable

# Copia il resto del codice sorgente del frontend
COPY webui/ .

# Compila l'applicazione per la produzione durante la build dell'immagine
RUN yarn run build-prod

# Rende /app accessibile a qualsiasi utente (es. utente non-root dei test del professore)
RUN chmod -R 777 /app

# Espone la porta 4173
EXPOSE 4173

# Avvia il server vite preview
CMD ["yarn", "run", "preview", "--host", "0.0.0.0"]
