# ---- Build Stage ----
FROM golang:1.21 AS builder

# Imposta la working directory nel container
WORKDIR /src

# Copia i file di dipendenze e la directory vendor
COPY go.mod go.sum ./
COPY vendor/ vendor/

# Copia tutto il codice sorgente
COPY . .

# Compila il binario.
# CGO_ENABLED=1 è necessario per go-sqlite3.
# -mod=vendor forza l'uso della directory vendor locale.
RUN CGO_ENABLED=1 go build -mod=vendor -o /app/webapi ./cmd/webapi

# ---- Run Stage ----
FROM debian:bookworm-slim

# Installa le librerie C necessarie a runtime per SQLite (linkato dinamicamente via CGO)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libc6 \
    && rm -rf /var/lib/apt/lists/*

# Crea la directory di lavoro dell'applicazione
WORKDIR /app

# Copia il binario compilato dallo stage di build
COPY --from=builder /app/webapi .

# Espone la porta dell'API (default 3000)
EXPOSE 3000

# Avvia il server
CMD ["./webapi"]
